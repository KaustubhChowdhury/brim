{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Brim",
  "version": "1.6.1",
  "identifier": "dev.wispdock.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "dock",
        "title": "Brim",
        "url": "index.html",
        "width": 196,
        "height": 52,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Utility",
    "shortDescription": "A floating utility dock for the top of your Windows screen",
    "longDescription": "Brim is a compact floating island with media controls, clipboard history, an app launcher, tasks, reminders, a local calendar, snippets and wallpapers. Everything stays on your computer.",
    "copyright": "Copyright 2026 Kaustubh Chowdhury. All rights reserved.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "both",
        "installerHooks": "./windows/hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "headerImage": "windows/header.bmp",
        "sidebarImage": "windows/sidebar.bmp",
        "startMenuFolder": "Brim",
        "compression": "lzma",
        "displayLanguageSelector": false
      }
    },
    "publisher": "Brim",
    "licenseFile": "../LICENSE.txt",
    "resources": {
      "../LICENSE.txt": "LICENSE.txt",
      "../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    }
  }
}
